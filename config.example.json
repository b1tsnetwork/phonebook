{
  "addr": ":8080",
  "publicURL": "https://telefonbuch.firma.local",
  "trustedProxies": ["127.0.0.1"],

  "tls": { "certFile": "", "keyFile": "" },

  "storage": {
    "mode": "mysql",
    "jsonPath": "/data/telefonbuch.json",
    "jsonAuditPath": "/data/audit.json",
    "jsonSnapshotInterval": "1h",
    "mysqlImport": "off",
    "mysqlImportInterval": "",
    "mysqlImportMinPercent": 50,
    "fallbackToJSON": true,
    "fallbackRetry": "30s"
  },

  "db": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "telefonbuch",
    "password": "",
    "name": "telefonbuch",
    "tls": ""
  },

  "auth": {
    "mode": "ldap",
    "sessionIdle": "2h",
    "sessionMax": "12h",
    "cookieSecure": "auto",
    "maxFailsPerIP": 20,
    "maxFailsPerUser": 5,
    "lockDuration": "10m",
    "publicDirectory": true,
    "devAdmin": false,
    "devAdminUser": "devadmin"
  },

  "ldap": {
    "url": "ldaps://dc01.firma.local:636",
    "caFile": "/etc/telefonbuch/firma-root-ca.pem",
    "timeout": "10s",
    "bindDN": "CN=svc-telefonbuch,OU=Dienstkonten,DC=firma,DC=local",
    "bindPassword": "",
    "baseDN": "OU=Benutzer,DC=firma,DC=local",
    "userFilter": "(&(objectCategory=person)(objectClass=user)(sAMAccountName={username}))",
    "adminGroupDN": "CN=GG-Telefonbuch-Admins,OU=Gruppen,DC=firma,DC=local",
    "userGroupDN": "",
    "nestedGroups": true,
    "attributes": {
      "username": "sAMAccountName",
      "lastName": "sn",
      "firstName": "givenName",
      "displayName": "displayName",
      "phone": "telephoneNumber",
      "mobile": "mobile",
      "room": "physicalDeliveryOfficeName",
      "amt": "department",
      "email": "mail",
      "guid": "objectGUID"
    }
  },

  "adSync": {
    "enabled": false,
    "interval": "6h",
    "baseDN": "",
    "filter": "(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))",
    "pageSize": 500,
    "fields": ["lastName", "firstName", "phone", "mobile", "room", "amt", "email"],
    "deactivateMissing": true,
    "maxDeactivatePercent": 30,
    "skipWithoutPhone": false
  },

  "features": {
    "userCreatesTags": true,
    "maxTagsPerUser": 40,
    "maxPrivateContacts": 300,
    "autoCreateOnLogin": true
  }
}
